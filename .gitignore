# Secrets and environment — never commit
.env
.env.*
.env.example
*.pem
*.key
secrets/
credentials.json

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# Node / frontend tooling
node_modules/
.npm/
*.local

# Database artifacts
*.sql.gz
*.dump
db-data/
postgres-data/

# Full ICD-10 catalogue imported locally (NCPHA terms; do not redistribute)
backend/app/data/icd10_bg.json
backend/app/data/*.xlsx
backend/app/data/*.docx

# Logs and runtime
*.log
logs/
# app/logs is application source, not runtime output
!backend/app/logs/
!backend/app/logs/**/*.py
tmp/
.opencode/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

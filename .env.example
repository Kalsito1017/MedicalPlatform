# ============================================================================
# Clinical AI Platform — example environment configuration.
# Copy to .env and fill in real values. NEVER commit the populated .env file.
# All values below are placeholders.
# ============================================================================

# --- Core application ---
APP_ENV=development                 # development | test | production
APP_SECRET_KEY=change-me-32-byte-random-string
PUBLIC_ORIGIN=http://localhost:8000 # The origin the browser loads the app from
API_BASE_URL=http://localhost:8000  # Backend base URL used by the frontend

# --- Database (PostgreSQL) ---
# Use a least-privilege application role, never the superuser.
DATABASE_URL=postgresql+asyncpg://app:change-me@localhost:5432/clinical_demo
# Separate URL used only by migrations when elevated rights are needed.
MIGRATION_DATABASE_URL=postgresql+asyncpg://migrator:change-me@localhost:5432/clinical_demo

# --- Sessions ---
SESSION_COOKIE_NAME=cap_session
SESSION_TTL_HOURS=8

# --- LLM (optional; the app runs fully without it) ---
# Put the API key here and the LLM auto-enables (LLM_ENABLED=None/absent).
# Set LLM_ENABLED=false only when you want an explicit kill switch.
# LLM_ENABLED=false
#
# OpenCode Go model (requires an active Go subscription):
LLM_API_BASE_URL=https://opencode.ai/inference/go
LLM_API_KEY=oc_sk_replace_me
LLM_MODEL=deepseek-v4.1-flash
# Standard OpenCode inference alternative (funded API key or free quota):
# LLM_API_BASE_URL=https://opencode.ai/inference
# LLM_MODEL=gpt-6-luna
# Free-only models are subject to the OpenCode free usage limit, e.g.:
# LLM_MODEL=mimo-v2.6-flash-free
LLM_MAX_TOOL_CALLS=4
# Tool-call budget for the general (no patient_id) AI lookup mode. Clamped 1-20.
LLM_MAX_TOOL_CALLS_GENERAL=10
LLM_REQUEST_TIMEOUT_SECONDS=45

# --- Appointments / clinic timezone ---
# IANA timezone used for working hours, display, and local->UTC conversion.
CLINIC_TIMEZONE=Europe/Sofia

# --- Voice transcription (optional self-hosted whisper.cpp) ---
# Leave WHISPER_BASE_URL empty to disable voice; manual scheduling still works.
# Local compose with the speech profile: http://speech:8080
WHISPER_BASE_URL=
WHISPER_TIMEOUT_SECONDS=45
WHISPER_MODEL_NAME=tiny
# none | bearer | gcp_iam
WHISPER_AUTH_MODE=none
# Required when WHISPER_AUTH_MODE=bearer. Never commit a real token.
WHISPER_BEARER_TOKEN=
# Required when WHISPER_AUTH_MODE=gcp_iam (Cloud Run service URL/audience).
WHISPER_AUDIENCE=
# Voice upload allowance for the transcription route only (hard cap 8388608).
VOICE_MAX_UPLOAD_BYTES=4194304
VOICE_MAX_DURATION_SECONDS=60
VOICE_FFMPEG_TIMEOUT_SECONDS=30
# Optional compose speech-service tuning.
WHISPER_THREADS=2

# --- Demo bootstrap (local/demo seeding only; never real credentials) ---
# Set at seed time only. Do not commit values.
# DEMO_ADMIN_* seeds the Admin demo account (role `clinical_admin`, display
# label "Admin"): the all-permissions account — clinical reads, staff
# management, role assignment, audit, and analytics.
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=replace-me-at-seed-time
DEMO_DOCTOR_EMAIL=doctor@example.com
DEMO_DOCTOR_PASSWORD=replace-me-at-seed-time
DEMO_NURSE_EMAIL=nurse@example.com
DEMO_NURSE_PASSWORD=replace-me-at-seed-time

# --- Docker / container runtime (optional; compose supplies sane dev defaults) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clinical_demo
POSTGRES_PORT=5432
APP_PORT=8000
# Run Alembic migrations automatically on container start (1 = yes, 0 = run manually).
RUN_MIGRATIONS_ON_START=1
# Optional override of the static frontend directory served by the backend.
# FRONTEND_DIR=/app/frontend

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
